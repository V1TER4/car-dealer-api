APP_NAME="Vehicle Platform API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://api.localhost:8080

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=vehicle_platform
DB_USERNAME=vehicle_platform
DB_PASSWORD=vehicle_platform_dev

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.localhost
SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1,api.localhost,painel.localhost,loja-a.localhost,loja-b.localhost
SANCTUM_TOKEN_EXPIRATION=120

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

FRONTEND_URL=http://painel.localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://painel.localhost:5173,http://loja-a.localhost:5173,http://loja-b.localhost:5173

# Opcional: somente para criar um usuário demonstrativo durante o seeding local.
SEED_ADMIN_EMAIL=admin@example.test
SEED_ADMIN_PASSWORD=
